{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile containing anthropometrics, training parameters, goals, and app preferences",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "age": { "type": "number" },
        "heightCm": { "type": "number" },
        "currentWeightKg": { "type": "number" },
        "goalWeightKg": { "type": "number" },
        "trainingDaysPerWeek": { "type": "number" },
        "level": { "type": "string" },
        "preferredLocation": { "type": "string" },
        "mode": { "type": "string" },
        "activityLevel": { "type": "string" },
        "currentWaistCm": { "type": "number" },
        "startDate": { "type": "string" },
        "dailyCalorieTarget": { "type": "number" },
        "dailyProteinTargetGrams": { "type": "number" },
        "dailyWaterTargetMl": { "type": "number" },
        "theme": { "type": "string" },
        "language": { "type": "string" },
        "unitSystem": { "type": "string" }
      },
      "required": ["name", "currentWeightKg", "goalWeightKg"]
    },
    "WorkoutSession": {
      "title": "WorkoutSession",
      "description": "Completed or active strength workout session with exercises, sets, reps, weight, and volume",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "name": { "type": "string" },
        "nameAr": { "type": "string" },
        "type": { "type": "string" },
        "mode": { "type": "string" },
        "durationMinutes": { "type": "number" },
        "totalVolumeKg": { "type": "number" },
        "completed": { "type": "boolean" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "date", "name", "completed"]
    },
    "NutritionEntry": {
      "title": "NutritionEntry",
      "description": "Daily food log entry tracking calories, macronutrients, and meal types",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "mealType": { "type": "string" },
        "foodName": { "type": "string" },
        "calories": { "type": "number" },
        "proteinGrams": { "type": "number" },
        "carbsGrams": { "type": "number" },
        "fatGrams": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "date", "mealType", "foodName", "calories", "proteinGrams"]
    },
    "BodyMeasurement": {
      "title": "BodyMeasurement",
      "description": "Anthropometric measurement record for tracking weight, waist circumference, and progress",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "weight": { "type": "number" },
        "waistCm": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "date", "weight"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Root user document holding the profile and synchronization metadata"
    },
    "/users/{userId}/workouts/{workoutId}": {
      "schema": "WorkoutSession",
      "description": "Subcollection of completed and logged workout sessions"
    },
    "/users/{userId}/nutrition/{nutritionId}": {
      "schema": "NutritionEntry",
      "description": "Subcollection of logged nutrition entries"
    },
    "/users/{userId}/measurements/{measurementId}": {
      "schema": "BodyMeasurement",
      "description": "Subcollection of physical body measurements"
    }
  }
}
